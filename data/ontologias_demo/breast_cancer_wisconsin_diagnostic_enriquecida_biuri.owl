<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:dct="http://purl.org/dc/terms/"
         xml:base="https://w3id.org/xai-ontologies/breast_cancer_wisconsin_diagnostic" xmlns="https://w3id.org/xai-ontologies/breast_cancer_wisconsin_diagnostic#">

<owl:Ontology rdf:about="https://w3id.org/xai-ontologies/breast_cancer_wisconsin_diagnostic">
  <dct:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Breast Cancer Wisconsin (Diagnostic) — ontologia de domínio enriquecida para o BIURI</dct:title>
  <dct:source rdf:resource="https://archive.ics.uci.edu/dataset/17/breast+cancer+wisconsin+diagnostic"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de domínio com nomes UCI (campo_dataset do mapeo; zero instâncias; rótulos e resultados não consultados). Conhecimento de domínio codificado: (1) as 30 features são 10 medidas morfológicas do núcleo celular × 3 estatísticas — média (mean), erro padrão (error) e pior valor (worst, média dos três maiores valores); cada propriedade declara a sua measurementFamily e o seu statisticRole, o que permite ao BIURI relacionar a mesma característica entre estatísticas; (2) as medidas agrupam-se, segundo a descrição do dicionário do dataset, em geometria de tamanho (raio, perímetro, área), indentação do contorno (compacidade, concavidade, pontos côncavos), regularidade da fronteira (suavidade, simetria, dimensão fractal) e textura de intensidade; cada propriedade tem como domínio a classe «estatística × subfamília»; (3) todas as medidas são grandezas não negativas (faceta xsd:minInclusive 0). ESTATUTO: descrição citada de memória do dicionário público do dataset, NÃO verificada neste ambiente; revisão humana pendente.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biuri-5.0</owl:versionInfo>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="#measurementFamily"/>
<owl:AnnotationProperty rdf:about="#biuriColumnName"/>
<owl:AnnotationProperty rdf:about="#biuriIsTarget"/>
<owl:AnnotationProperty rdf:about="#biuriClassOrder"/>
<owl:AnnotationProperty rdf:about="#statisticRole"/>

<owl:Class rdf:about="#DiagnosisTarget"><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnosis (target variable)</rdfs:label><biuriColumnName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnosis</biuriColumnName><biuriIsTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true</biuriIsTarget><biuriClassOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M,B</biuriClassOrder></owl:Class>
<owl:Class rdf:about="#NuclearMeasurement"><rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear measurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#MeanStatisticMeasurement"><rdfs:subClassOf rdf:resource="#NuclearMeasurement"/><owl:disjointWith rdf:resource="#StandardErrorStatisticMeasurement"/><owl:disjointWith rdf:resource="#WorstStatisticMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mean statistic measurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#StandardErrorStatisticMeasurement"><rdfs:subClassOf rdf:resource="#NuclearMeasurement"/><owl:disjointWith rdf:resource="#WorstStatisticMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StandardError statistic measurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#WorstStatisticMeasurement"><rdfs:subClassOf rdf:resource="#NuclearMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Worst statistic measurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#SizeGeometryMeasurement"><rdfs:subClassOf rdf:resource="#NuclearMeasurement"/><owl:disjointWith rdf:resource="#ContourIndentationMeasurement"/><owl:disjointWith rdf:resource="#BoundaryRegularityMeasurement"/><owl:disjointWith rdf:resource="#IntensityTextureMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SizeGeometry measurement family</rdfs:label></owl:Class>
<owl:Class rdf:about="#ContourIndentationMeasurement"><rdfs:subClassOf rdf:resource="#NuclearMeasurement"/><owl:disjointWith rdf:resource="#BoundaryRegularityMeasurement"/><owl:disjointWith rdf:resource="#IntensityTextureMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ContourIndentation measurement family</rdfs:label></owl:Class>
