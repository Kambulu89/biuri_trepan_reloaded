<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://w3id.org/biuri/trepan-reloaded/breast_cancer"
         xmlns="https://w3id.org/biuri/trepan-reloaded/breast_cancer#">

<owl:Ontology rdf:about="https://w3id.org/biuri/trepan-reloaded/breast_cancer">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIURI domain-rich TBox for Breast Cancer Wisconsin Diagnostic</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox/controlled vocabulary only: contains zero dataset rows, patients, samples, split identifiers or learned thresholds.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature aliases are schema mappings documented by the data source; they are not test-derived matches.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://archive.ics.uci.edu/dataset/17/breast+cancer+wisconsin+diagnostic</rdfs:seeAlso>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4.0-domain-rich-relational</owl:versionInfo>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurements describe cell-nucleus morphology from digitized FNA images.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v4: adds measurementFamily/statisticRole annotations, per-family and per-concept (size/shape/texture) super-properties. TBox only.</rdfs:comment>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="#measurementFamily"/>
<owl:AnnotationProperty rdf:about="#statisticRole"/>

<owl:ObjectProperty rdf:about="#hasDomainOutcome">
  <rdfs:domain rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:range rdf:resource="#BreastMassDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has Breast Cancer Wisconsin Diagnostic outcome</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasMeanNuclearMorphometricValue">
  <rdfs:domain rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean nuclear morphometry</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasNuclearMeasurementErrorValue">
  <rdfs:domain rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
