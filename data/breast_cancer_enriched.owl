<owl:Class rdf:about="#BreastMassCytologyProfile">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">breast-mass nuclear cytology profile</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semantic subject described by the Breast Cancer Wisconsin Diagnostic feature schema.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NuclearSizeProfile">
  <rdfs:subClassOf rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear size profile</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NuclearShapeProfile">
  <rdfs:subClassOf rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear shape profile</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NuclearTextureProfile">
  <rdfs:subClassOf rdf:resource="#BreastMassCytologyProfile"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nuclear texture profile</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BreastMassDiagnosis">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Breast Cancer Wisconsin Diagnostic outcome</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MalignantDiagnosis">
  <rdfs:subClassOf rdf:resource="#BreastMassDiagnosis"/>
  <owl:disjointWith rdf:resource="#BenignDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">malignant</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#BenignDiagnosis">
  <rdfs:subClassOf rdf:resource="#BreastMassDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">benign</rdfs:label>
</owl:Class>


