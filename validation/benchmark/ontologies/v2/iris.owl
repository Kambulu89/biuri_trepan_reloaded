<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/trepan-benchmark/iris"
         xmlns="http://example.org/trepan-benchmark/iris#">

<owl:Ontology rdf:about="http://example.org/trepan-benchmark/iris">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de benchmark: contém semântica de domínio e zero instâncias do dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A estrutura foi definida apenas a partir da descrição das features; rótulos, partições e resultados do benchmark não foram consultados.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Versão 2: acrescenta relações entre grandezas declaradas por anotação derivedRelation ("operação:outraPropriedade[:expoenteEsquerdo:expoenteDireito]"). Cada relação tem estatuto (PROVADO/INFERIDO) e justificação no comentário da propriedade. Nenhuma relação foi escolhida com base em rótulos, resultados ou métricas.</rdfs:comment>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="#derivedRelation"/>
<owl:AnnotationProperty rdf:about="#knowledgeStatus"/>

<owl:DatatypeProperty rdf:about="#hasSepalLengthCm">
  <rdfs:domain rdf:resource="#SepalMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sepal length (cm)</rdfs:label>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasSepalWidthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasSepalWidthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasSepalWidthCm (INFERIDO): comprimento × largura: aproximação retangular da área da sépala (geometria elementar; descritor morfométrico corrente).</rdfs:comment>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm (INFERIDO): comprimento / largura: razão de aspeto da sépala (descritor de forma independente do tamanho).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSepalWidthCm">
  <rdfs:domain rdf:resource="#SepalMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sepal width (cm)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPetalLengthCm">
  <rdfs:domain rdf:resource="#PetalMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">petal length (cm)</rdfs:label>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasPetalWidthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasPetalWidthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product:hasPetalWidthCm (INFERIDO): comprimento × largura: aproximação retangular da área da pétala.</rdfs:comment>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasPetalWidthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasPetalWidthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasPetalWidthCm (INFERIDO): comprimento / largura: razão de aspeto da pétala.</rdfs:comment>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalLengthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalLengthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalLengthCm (INFERIDO): comprimento da pétala / comprimento da sépala: tamanho relativo de dois órgãos do mesmo perianto.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPetalWidthCm">
  <rdfs:domain rdf:resource="#PetalMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">petal width (cm)</rdfs:label>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasSepalWidthCm (INFERIDO): largura da pétala / largura da sépala: tamanho relativo de dois órgãos do mesmo perianto.</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#DomainMeasurement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iris domain measurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SepalMeasurement">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <owl:disjointWith rdf:resource="#PetalMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SepalMeasurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PetalMeasurement">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PetalMeasurement</rdfs:label>
</owl:Class>


</rdf:RDF>
