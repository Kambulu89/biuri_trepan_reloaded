<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/trepan-audit/phys_power" xmlns="http://example.org/trepan-audit/phys_power#">
<owl:Ontology rdf:about="http://example.org/trepan-audit/phys_power">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de CONTROLO POSITIVO (auditoria, fase 6). Estado elétrico de uma carga resistiva e contexto da instalação. Zero instâncias. A relação declarada é a lei física que gerou os dados; o dataset é sintético.</rdfs:comment>
</owl:Ontology>
<owl:AnnotationProperty rdf:about="#derivedRelation"/>
<owl:AnnotationProperty rdf:about="#knowledgeStatus"/>
<owl:Class rdf:about="#DomainMeasurement"><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DomainMeasurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#ElectricalState"><rdfs:subClassOf rdf:resource="#DomainMeasurement"/><owl:disjointWith rdf:resource="#InstallationContext"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ElectricalState</rdfs:label></owl:Class>
<owl:Class rdf:about="#InstallationContext"><rdfs:subClassOf rdf:resource="#DomainMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InstallationContext</rdfs:label></owl:Class>
<owl:DatatypeProperty rdf:about="#hasVoltage">
  <rdfs:domain rdf:resource="#ElectricalState"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">voltage_v</rdfs:label>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasResistance:2:1</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasResistance:2:1 — PROVADO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasResistance:2:1 (PROVADO): tensão² / resistência é a potência dissipada, P = V²/R (lei de Ohm e de Joule).</rdfs:comment>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasResistance">
  <rdfs:domain rdf:resource="#ElectricalState"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resistance_ohm</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasCableLength">
  <rdfs:domain rdf:resource="#InstallationContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cable_length_m</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasAmbientTemperature">
  <rdfs:domain rdf:resource="#InstallationContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ambient_temperature_c</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasWireCrossSection">
  <rdfs:domain rdf:resource="#InstallationContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wire_cross_section_mm2</rdfs:label>
</owl:DatatypeProperty>
</rdf:RDF>
