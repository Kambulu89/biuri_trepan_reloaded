<owl:Class rdf:about="#DomainMeasurement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">breast_cancer domain measurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MeanMorphology">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeanMorphology</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ErrorMorphology">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ErrorMorphology</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#WorstMorphology">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WorstMorphology</rdfs:label>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#MeanMorphology"/>
    <rdf:Description rdf:about="#ErrorMorphology"/>
    <rdf:Description rdf:about="#WorstMorphology"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
