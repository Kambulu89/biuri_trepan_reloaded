  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worst</statisticRole>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius:1:2</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius:1:2 — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius:1:2 (INFERIDO): área / raio² nos piores valores: π num círculo.</rdfs:comment>
</owl:DatatypeProperty>

