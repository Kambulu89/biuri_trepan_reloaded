  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worst perimeter</rdfs:label>
  <measurementFamily rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perimeter</measurementFamily>
  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worst</statisticRole>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstArea:2:1</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstArea:2:1 — PROVADO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstArea:2:1 (PROVADO): perímetro² / área nos piores valores: definição de compacidade do dicionário de dados. Fonte: Street, Wolberg, Mangasarian (1993).</rdfs:comment>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasWorstRadius (INFERIDO): perímetro / raio nos piores valores: 2π num círculo.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasWorstArea">
