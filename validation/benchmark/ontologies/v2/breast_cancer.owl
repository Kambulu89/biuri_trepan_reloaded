<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/trepan-benchmark/breast-cancer"
         xmlns="http://example.org/trepan-benchmark/breast-cancer#">

<owl:Ontology rdf:about="http://example.org/trepan-benchmark/breast-cancer">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de benchmark: contém semântica de domínio e zero instâncias do dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A estrutura foi definida apenas a partir da descrição das features; rótulos, partições e resultados do benchmark não foram consultados.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Versão 2: acrescenta relações entre grandezas declaradas por anotação derivedRelation ("operação:outraPropriedade[:expoenteEsquerdo:expoenteDireito]"). Cada relação tem estatuto (PROVADO/INFERIDO) e justificação no comentário da propriedade. Nenhuma relação foi escolhida com base em rótulos, resultados ou métricas.</rdfs:comment>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="#derivedRelation"/>
<owl:AnnotationProperty rdf:about="#knowledgeStatus"/>

<owl:AnnotationProperty rdf:about="#measurementFamily"/>
<owl:AnnotationProperty rdf:about="#statisticRole"/>

<owl:DatatypeProperty rdf:about="#hasMeanRadius">
  <rdfs:domain rdf:resource="#MeanMorphology"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean radius</rdfs:label>
  <measurementFamily rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radius</measurementFamily>
  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean</statisticRole>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMeanTexture">
  <rdfs:domain rdf:resource="#MeanMorphology"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean texture</rdfs:label>
  <measurementFamily rdf:datatype="http://www.w3.org/2001/XMLSchema#string">texture</measurementFamily>
  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean</statisticRole>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMeanPerimeter">
  <rdfs:domain rdf:resource="#MeanMorphology"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean perimeter</rdfs:label>
  <measurementFamily rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perimeter</measurementFamily>
  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean</statisticRole>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanArea:2:1</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanArea:2:1 — PROVADO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanArea:2:1 (PROVADO): perímetro² / área: é a definição de compacidade do dicionário de dados (compactness = perimeter² / area − 1.0). Fonte: Street, Wolberg, Mangasarian (1993), Nuclear feature extraction for breast tumor diagnosis.</rdfs:comment>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius (INFERIDO): perímetro / raio: vale 2π num círculo; mede o desvio da forma circular.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMeanArea">
  <rdfs:domain rdf:resource="#MeanMorphology"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean area</rdfs:label>
  <measurementFamily rdf:datatype="http://www.w3.org/2001/XMLSchema#string">area</measurementFamily>
  <statisticRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean</statisticRole>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius:1:2</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius:1:2 — INFERIDO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasMeanRadius:1:2 (INFERIDO): área / raio²: vale π num círculo; mede o desvio da forma circular.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMeanSmoothness">
  <rdfs:domain rdf:resource="#MeanMorphology"/>
