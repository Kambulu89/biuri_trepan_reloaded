<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/trepan-audit/phys_bmi" xmlns="http://example.org/trepan-audit/phys_bmi#">
<owl:Ontology rdf:about="http://example.org/trepan-audit/phys_bmi">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de CONTROLO POSITIVO (auditoria, fase 6). Medidas corporais e contexto clínico de um adulto. Zero instâncias. A relação declarada é a lei física que gerou os dados; o dataset é sintético.</rdfs:comment>
</owl:Ontology>
<owl:AnnotationProperty rdf:about="#derivedRelation"/>
<owl:AnnotationProperty rdf:about="#knowledgeStatus"/>
<owl:Class rdf:about="#DomainMeasurement"><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DomainMeasurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#BodyMeasurement"><rdfs:subClassOf rdf:resource="#DomainMeasurement"/><owl:disjointWith rdf:resource="#ClinicalContext"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BodyMeasurement</rdfs:label></owl:Class>
<owl:Class rdf:about="#ClinicalContext"><rdfs:subClassOf rdf:resource="#DomainMeasurement"/><rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClinicalContext</rdfs:label></owl:Class>
<owl:DatatypeProperty rdf:about="#hasHeightM">
  <rdfs:domain rdf:resource="#BodyMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height_m</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasMassKg">
  <rdfs:domain rdf:resource="#BodyMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mass_kg</rdfs:label>
  <derivedRelation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasHeightM:1:2</derivedRelation>
  <knowledgeStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasHeightM:1:2 — PROVADO</knowledgeStatus>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ratio:hasHeightM:1:2 (PROVADO): massa / altura² é a definição do índice de massa corporal (OMS).</rdfs:comment>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasAgeYears">
  <rdfs:domain rdf:resource="#ClinicalContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">age_years</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasSystolicBp">
  <rdfs:domain rdf:resource="#ClinicalContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">systolic_bp_mmhg</rdfs:label>
</owl:DatatypeProperty>
<owl:DatatypeProperty rdf:about="#hasRestingHeartRate">
  <rdfs:domain rdf:resource="#ClinicalContext"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resting_heart_rate_bpm</rdfs:label>
</owl:DatatypeProperty>
</rdf:RDF>
