</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFeat6">
  <rdfs:domain rdf:resource="#GroupC"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feat_6</rdfs:label>
