<owl:Class rdf:about="#DomainMeasurement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthetic_binary domain measurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#GroupA">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GroupA</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#GroupB">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GroupB</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#GroupC">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GroupC</rdfs:label>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#GroupA"/>
    <rdf:Description rdf:about="#GroupB"/>
    <rdf:Description rdf:about="#GroupC"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
