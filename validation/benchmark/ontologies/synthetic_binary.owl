  <rdfs:domain rdf:resource="#GroupB"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feat_4</rdfs:label>
</owl:DatatypeProperty>

