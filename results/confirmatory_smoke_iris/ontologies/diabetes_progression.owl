<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/trepan-benchmark/diabetes-progression"
         xmlns="http://example.org/trepan-benchmark/diabetes-progression#">

<owl:Ontology rdf:about="http://example.org/trepan-benchmark/diabetes-progression">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TBox de benchmark: contém semântica de domínio e zero instâncias do dataset.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A estrutura foi definida apenas a partir da descrição das features; rótulos, partições e resultados do benchmark não foram consultados.</rdfs:comment>
</owl:Ontology>

<owl:DatatypeProperty rdf:about="#hasAge">
  <rdfs:domain rdf:resource="#DemographicMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">age</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSex">
  <rdfs:domain rdf:resource="#DemographicMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sex</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBmi">
  <rdfs:domain rdf:resource="#AnthropometricMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bmi</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasBp">
  <rdfs:domain rdf:resource="#AnthropometricMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bp</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS1">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s1</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS2">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s2</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS3">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s3</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS4">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s4</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS5">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s5</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasS6">
  <rdfs:domain rdf:resource="#SerumMeasurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">s6</rdfs:label>
</owl:DatatypeProperty>

<owl:Class rdf:about="#DomainMeasurement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diabetes_progression domain measurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DemographicMeasurement">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DemographicMeasurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AnthropometricMeasurement">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AnthropometricMeasurement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SerumMeasurement">
  <rdfs:subClassOf rdf:resource="#DomainMeasurement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SerumMeasurement</rdfs:label>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#DemographicMeasurement"/>
    <rdf:Description rdf:about="#AnthropometricMeasurement"/>
    <rdf:Description rdf:about="#SerumMeasurement"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
